<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>VehicleDetection</RootNamespace>
    <AssemblyName>VehicleDetection</AssemblyName>
    <Product>Vehicle Detection</Product>
    <Description>Real-time vehicle detection, tracking and counting with Emgu.CV.</Description>
    <Copyright>Copyright © 2018-2026</Copyright>
    <Version>2.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- ONNX Runtime 1.15 ships osx.10.14 runtime ids that .NET 8 no longer resolves.
         The project is Windows only anyway, so the notice is noise. -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Emgu.CV" Version="4.8.1.5350" />
    <PackageReference Include="Emgu.CV.runtime.windows" Version="4.8.1.5350" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.15.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="assets\Relaxing_highway_traffic.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- Whatever .onnx the user dropped in; the folder may legitimately be empty. -->
    <None Include="models\*.onnx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
