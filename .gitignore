# Build output
[Bb]in/
[Oo]bj/

# Visual Studio / Rider
.vs/
.idea/
*.user
*.suo

# NuGet (packages are restored from nuget.org via PackageReference)
packages/
*.nupkg

# Runtime output of the app
snapshots/

# Neural network weights. yolov10n.onnx is committed so the project runs out of the
# box; it carries its own licence, see VehicleDetection/models/README.md. Any other
# model a user downloads stays out of the repository.
VehicleDetection/models/*.onnx
!VehicleDetection/models/yolov10n.onnx
